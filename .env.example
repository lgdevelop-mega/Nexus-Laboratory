# Copia este archivo como .env solo en tu máquina local. Nunca subas .env al repositorio.
# La app carga .env únicamente cuando NEXUS_APP_ENV=local; en los demás ambientes
# las variables vienen del entorno del proceso.

# --- Aplicación ---------------------------------------------------------------
NEXUS_APP_ENV=local
NEXUS_LOG_LEVEL=INFO
NEXUS_DOCS_ENABLED=true

# Driver aprobado: asyncmy (D-02). Valores ficticios: cámbialos en tu .env.
NEXUS_DATABASE_URL=mysql+asyncmy://nexus:cambia-esta-clave@127.0.0.1:3306/nexus?charset=utf8mb4
NEXUS_DB_POOL_SIZE=5
NEXUS_DB_POOL_RECYCLE_SECONDS=1500
NEXUS_DB_ECHO=false

# Lista JSON de orígenes permitidos, por ejemplo ["http://localhost:5173"].
NEXUS_CORS_ORIGINS=[]
# false mientras el token viaje en Authorization: Bearer (D-04).
NEXUS_CORS_ALLOW_CREDENTIALS=false

# Vigencia absoluta del token de sesión, en horas (L-03).
NEXUS_SESSION_TTL_HOURS=12

# --- docker compose (solo entorno local) --------------------------------------
NEXUS_DB_USER=nexus
NEXUS_DB_PASSWORD=cambia-esta-clave
NEXUS_DB_ROOT_PASSWORD=cambia-esta-clave-root
NEXUS_DB_PORT=3306
